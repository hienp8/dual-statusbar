<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/app_name">

    <SwitchPreferenceCompat android:key="enabled" android:title="Bật module" android:defaultValue="true" />

    <PreferenceScreen android:key="scr_dual" android:title="Thanh 2 dòng" android:summary="Chiều cao và vị trí các biểu tượng gốc">
            <SwitchPreferenceCompat android:key="dual_enabled" android:title="Bật chế độ 2 dòng" android:summary="Đổi chiều cao nên khởi động lại máy để vùng nội dung ứng dụng khớp" android:defaultValue="true" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="bar_height_dp" android:title="Chiều cao thanh (dp)"
                app:min="24" android:max="80" app:showSeekBarValue="true" android:defaultValue="44" />
            <ListPreference android:key="pos_clock" android:title="Vị trí đồng hồ số gốc"
                android:entries="@array/pos_entries_def" android:entryValues="@array/pos_values_def"
                android:defaultValue="0" app:useSimpleSummaryProvider="true" />
            <ListPreference android:key="pos_notif" android:title="Vị trí biểu tượng thông báo"
                android:entries="@array/pos_entries_def" android:entryValues="@array/pos_values_def"
                android:defaultValue="6" app:useSimpleSummaryProvider="true" />
            <ListPreference android:key="pos_chip" android:title="Vị trí Now Bar (chip trên thanh trạng thái)"
                android:entries="@array/pos_entries_chip" android:entryValues="@array/pos_values_chip"
                android:defaultValue="-2" app:useSimpleSummaryProvider="true" />
            <SwitchPreferenceCompat android:key="chip_forward_touch" android:title="Sửa lỗi bấm vào Now Bar"
                android:summary="Chuyển tiếp thao tác chạm tới Now Bar khi nó bị dời vị trí, để bấm vẫn mở rộng được"
                android:defaultValue="true" />
            <ListPreference android:key="kg_row" android:title="Màn hình khóa: vị trí biểu tượng gốc"
                android:entries="@array/kg_row_entries" android:entryValues="@array/kg_row_values"
                android:defaultValue="2" app:useSimpleSummaryProvider="true" />
            <ListPreference android:key="pos_icons" android:title="Vị trí biểu tượng hệ thống + pin"
                android:entries="@array/pos_entries_def" android:entryValues="@array/pos_values_def"
                android:defaultValue="5" app:useSimpleSummaryProvider="true" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="dx_clock" android:title="Dịch ngang đồng hồ gốc (dp)"
                app:min="-300" android:max="300" app:showSeekBarValue="true" android:defaultValue="0" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="dx_notif" android:title="Dịch ngang biểu tượng thông báo (dp)"
                app:min="-300" android:max="300" app:showSeekBarValue="true" android:defaultValue="0" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="dx_icons" android:title="Dịch ngang biểu tượng hệ thống (dp)"
                app:min="-300" android:max="300" app:showSeekBarValue="true" android:defaultValue="0" />
    </PreferenceScreen>

    <PreferenceScreen android:key="scr_bg" android:title="Hình nền" android:summary="Ảnh nền, kiểu hiển thị, độ mờ">
            <SwitchPreferenceCompat android:key="bg_enabled" android:title="Dùng hình nền" android:defaultValue="true" />
            <Preference android:key="pick_bg" android:title="Chọn ảnh nền" android:summary="PNG/WebP có nền trong suốt càng tốt" />
            <Preference android:key="clear_bg" android:title="Xoá ảnh nền" />
            <ListPreference android:key="bg_scale" android:title="Cách hiển thị"
                android:entries="@array/scale_entries" android:entryValues="@array/scale_values"
                android:defaultValue="0" app:useSimpleSummaryProvider="true" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="bg_alpha" android:title="Độ mờ (%)"
                app:min="0" android:max="100" app:showSeekBarValue="true" android:defaultValue="100" />
    </PreferenceScreen>

    <PreferenceScreen android:key="scr_time" android:title="Giờ &amp; dương lịch" android:summary="Chỉ giờ, giờ kèm dương lịch hoặc chỉ dương lịch">
            <SwitchPreferenceCompat android:key="digital_replace" android:title="Ẩn đồng hồ số gốc của Samsung" android:summary="Bật khi bạn dùng giờ / ngày của module hoặc đồng hồ analog. Đây là nơi duy nhất điều khiển việc ẩn" android:defaultValue="false" />
            <SwitchPreferenceCompat android:key="time_enabled" android:title="Hiện giờ / ngày của module" android:defaultValue="false" />
            <ListPreference android:key="time_content" android:title="Nội dung hiển thị"
                android:entries="@array/time_content_entries" android:entryValues="@array/time_content_values"
                android:defaultValue="0" app:useSimpleSummaryProvider="true" />
            <ListPreference android:key="time_layout" android:title="Cách xếp giờ và ngày"
                android:entries="@array/time_layout_entries" android:entryValues="@array/time_layout_values"
                android:defaultValue="0" app:useSimpleSummaryProvider="true" />
            <ListPreference android:key="time_format" android:title="Kiểu giờ"
                android:entries="@array/time_fmt_entries" android:entryValues="@array/time_fmt_values"
                android:defaultValue="HH:mm" app:useSimpleSummaryProvider="true" />
            <ListPreference android:key="solar_format" android:title="Kiểu dương lịch"
                android:entries="@array/date_fmt_entries" android:entryValues="@array/date_fmt_values"
                android:defaultValue="EEE, d MMM" app:useSimpleSummaryProvider="true" />
            <EditTextPreference android:key="solar_custom" android:title="Kiểu dương lịch tự gõ (tuỳ chọn)"
                android:summary="Mẫu SimpleDateFormat, thêm mã {thu} = Thứ 2, {am} = âm lịch 1/10, {canchi} = Bính Ngọ. Ví dụ: {thu}, dd/MM ({am}). Để trống để dùng kiểu ở trên"
                android:defaultValue="" />
            <ListPreference android:key="time_pos" android:title="Vị trí (cả giờ và ngày)"
                android:entries="@array/pos_entries" android:entryValues="@array/pos_values"
                android:defaultValue="0" app:useSimpleSummaryProvider="true" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="time_dx" android:title="Dịch ngang (dp)"
                app:min="-150" android:max="150" app:showSeekBarValue="true" android:defaultValue="0" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="time_dy" android:title="Dịch dọc (dp)"
                app:min="-30" android:max="30" app:showSeekBarValue="true" android:defaultValue="0" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="time_size" android:title="Cỡ chữ giờ (sp)"
                app:min="8" android:max="28" app:showSeekBarValue="true" android:defaultValue="14" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="solar_size" android:title="Cỡ chữ dương lịch (sp)"
                app:min="6" android:max="24" app:showSeekBarValue="true" android:defaultValue="11" />
            <ListPreference android:key="time_color" android:title="Màu giờ"
                android:entries="@array/color_auto_entries" android:entryValues="@array/color_auto_values"
                android:defaultValue="auto" app:useSimpleSummaryProvider="true" />
            <ListPreference android:key="solar_color" android:title="Màu dương lịch"
                android:entries="@array/color_auto_entries" android:entryValues="@array/color_auto_values"
                android:defaultValue="auto" app:useSimpleSummaryProvider="true" />
    </PreferenceScreen>

    <PreferenceScreen android:key="scr_lunar" android:title="Âm lịch" android:summary="Hiển thị, kiểu, kích thước, vị trí, màu">
            <SwitchPreferenceCompat android:key="lunar_enabled" android:title="Hiện âm lịch" android:summary="Tính theo thuật toán Hồ Ngọc Đức, múi giờ Việt Nam (UTC+7)" android:defaultValue="false" />
            <ListPreference android:key="lunar_format" android:title="Kiểu âm lịch"
                android:entries="@array/lunar_fmt_entries" android:entryValues="@array/lunar_fmt_values"
                android:defaultValue="0" app:useSimpleSummaryProvider="true" />
            <ListPreference android:key="lunar_pos" android:title="Vị trí"
                android:entries="@array/pos_entries" android:entryValues="@array/pos_values"
                android:defaultValue="8" app:useSimpleSummaryProvider="true" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="lunar_size" android:title="Cỡ chữ (sp)"
                app:min="6" android:max="24" app:showSeekBarValue="true" android:defaultValue="10" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="lunar_dx" android:title="Dịch ngang (dp)"
                app:min="-150" android:max="150" app:showSeekBarValue="true" android:defaultValue="0" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="lunar_dy" android:title="Dịch dọc (dp)"
                app:min="-30" android:max="30" app:showSeekBarValue="true" android:defaultValue="0" />
            <ListPreference android:key="lunar_color" android:title="Màu chữ"
                android:entries="@array/color_auto_entries" android:entryValues="@array/color_auto_values"
                android:defaultValue="auto" app:useSimpleSummaryProvider="true" />
    </PreferenceScreen>

    <PreferenceScreen android:key="scr_ring" android:title="Pin, Wi-Fi &amp; sóng" android:summary="Khối dạng vòng: pin, Wi-Fi, sóng di động">
            <SwitchPreferenceCompat android:key="ring_enabled" android:title="Hiện khối pin / Wi-Fi / sóng" android:summary="Vòng pin ở trên, chấm sóng cong ở dưới, Wi-Fi hoặc 4G/5G ở giữa" android:defaultValue="false" />
            <SwitchPreferenceCompat android:key="ring_percent" android:title="Hiện số % pin" android:defaultValue="true" />
            <SwitchPreferenceCompat android:key="ring_bolt" android:title="Hiện tia sét khi sạc" android:summary="Thay cho số % lúc đang sạc" android:defaultValue="true" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="ring_pct_height" android:title="Độ cao của số % (%)"
                app:min="0" android:max="100" app:showSeekBarValue="true" android:defaultValue="80" />
            <SwitchPreferenceCompat android:key="ring_show_wifi" android:title="Hiện Wi-Fi ở giữa vòng" android:summary="Chỉ hiện khi đang kết nối Wi-Fi" android:defaultValue="true" />
            <SwitchPreferenceCompat android:key="ring_show_nettype" android:title="Hiện loại mạng (5G/4G/3G) khi không có Wi-Fi" android:defaultValue="true" />
            <SwitchPreferenceCompat android:key="ring_show_signal" android:title="Hiện chấm sóng di động" android:summary="5 chấm xếp cong dưới vòng" android:defaultValue="true" />
            <ListPreference android:key="ring_pos" android:title="Vị trí"
                android:entries="@array/pos_entries" android:entryValues="@array/pos_values"
                android:defaultValue="5" app:useSimpleSummaryProvider="true" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="ring_size" android:title="Kích thước (dp)"
                app:min="14" android:max="48" app:showSeekBarValue="true" android:defaultValue="26" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="ring_stroke" android:title="Độ dày vòng (dp)"
                app:min="1" android:max="6" app:showSeekBarValue="true" android:defaultValue="2" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="ring_dx" android:title="Dịch ngang (dp)"
                app:min="-150" android:max="150" app:showSeekBarValue="true" android:defaultValue="0" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="ring_dy" android:title="Dịch dọc (dp)"
                app:min="-30" android:max="30" app:showSeekBarValue="true" android:defaultValue="0" />
            <ListPreference android:key="ring_color" android:title="Màu thường (vòng, chữ, Wi-Fi, chấm sóng)"
                android:entries="@array/color_auto_entries" android:entryValues="@array/color_auto_values"
                android:defaultValue="auto" app:useSimpleSummaryProvider="true" />
            <ListPreference android:key="ring_color_charging" android:title="Màu khi sạc"
                android:entries="@array/color_entries" android:entryValues="@array/color_values"
                android:defaultValue="#FF4CAF50" app:useSimpleSummaryProvider="true" />
            <ListPreference android:key="ring_color_saver" android:title="Màu khi tiết kiệm pin"
                android:entries="@array/color_entries" android:entryValues="@array/color_values"
                android:defaultValue="#FFFFC107" app:useSimpleSummaryProvider="true" />
            <ListPreference android:key="ring_color_low" android:title="Màu khi pin yếu"
                android:entries="@array/color_entries" android:entryValues="@array/color_values"
                android:defaultValue="#FFE53935" app:useSimpleSummaryProvider="true" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="ring_low_level" android:title="Ngưỡng pin yếu (%)"
                app:min="5" android:max="50" app:showSeekBarValue="true" android:defaultValue="20" />
            <SwitchPreferenceCompat android:key="ring_hide_stock" android:title="Ẩn biểu tượng pin của hệ thống" android:summary="Chỉ có tác dụng khi bật khối vòng" android:defaultValue="true" />
            <SwitchPreferenceCompat android:key="ring_hide_wifi" android:title="Ẩn biểu tượng Wi-Fi của hệ thống" android:defaultValue="true" />
            <SwitchPreferenceCompat android:key="ring_hide_signal" android:title="Ẩn biểu tượng sóng của hệ thống" android:defaultValue="true" />
    </PreferenceScreen>

    <PreferenceScreen android:key="scr_batline" android:title="Đường pin viền dưới" android:summary="Đường kẻ ngang căn giữa theo % pin">
            <SwitchPreferenceCompat android:key="battery_line" android:title="Hiện đường pin" android:defaultValue="true" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="battery_line_h" android:title="Độ dày (dp)"
                app:min="1" android:max="8" app:showSeekBarValue="true" android:defaultValue="2" />
            <ListPreference android:key="battery_color_normal" android:title="Màu thường"
                android:entries="@array/color_entries" android:entryValues="@array/color_values"
                android:defaultValue="#FFE53935" app:useSimpleSummaryProvider="true" />
            <ListPreference android:key="battery_color_charging" android:title="Màu khi sạc"
                android:entries="@array/color_entries" android:entryValues="@array/color_values"
                android:defaultValue="#FF4CAF50" app:useSimpleSummaryProvider="true" />
            <SwitchPreferenceCompat android:key="battery_anim" android:title="Hiệu ứng chấm xanh khi sạc"
                android:summary="Các chấm chạy từ hai lề vào hai đầu thanh pin" android:defaultValue="true" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="battery_anim_speed" android:title="Tốc độ chạy"
                app:min="1" android:max="10" app:showSeekBarValue="true" android:defaultValue="4" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="battery_anim_gap" android:title="Khoảng cách giữa các chấm (dp)"
                app:min="8" android:max="80" app:showSeekBarValue="true" android:defaultValue="28" />
    </PreferenceScreen>

    <PreferenceScreen android:key="scr_label" android:title="Nhà mạng / chữ tuỳ chỉnh" android:summary="Hiện tên nhà mạng hoặc dòng chữ riêng">
            <ListPreference android:key="label_mode" android:title="Chế độ"
                android:entries="@array/label_mode_entries" android:entryValues="@array/label_mode_values"
                android:defaultValue="0" app:useSimpleSummaryProvider="true" />
            <EditTextPreference android:key="label_text" android:title="Chữ tuỳ chỉnh"
                android:defaultValue="" app:useSimpleSummaryProvider="true" />
            <ListPreference android:key="label_pos" android:title="Vị trí"
                android:entries="@array/pos_entries" android:entryValues="@array/pos_values"
                android:defaultValue="1" app:useSimpleSummaryProvider="true" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="label_size" android:title="Cỡ chữ (sp)"
                app:min="6" android:max="20" app:showSeekBarValue="true" android:defaultValue="11" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="label_dx" android:title="Dịch ngang (dp)"
                app:min="-150" android:max="150" app:showSeekBarValue="true" android:defaultValue="0" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="label_dy" android:title="Dịch dọc (dp)"
                app:min="-30" android:max="30" app:showSeekBarValue="true" android:defaultValue="0" />
            <ListPreference android:key="label_color" android:title="Màu chữ"
                android:entries="@array/color_auto_entries" android:entryValues="@array/color_auto_values"
                android:defaultValue="auto" app:useSimpleSummaryProvider="true" />
    </PreferenceScreen>

    <PreferenceScreen android:key="scr_analog" android:title="Đồng hồ analog" android:summary="Vị trí, mặt đồng hồ, kim">
            <SwitchPreferenceCompat android:key="analog_enabled" android:title="Hiện đồng hồ analog" android:defaultValue="true" />
            <ListPreference android:key="analog_pos" android:title="Vị trí"
                android:entries="@array/pos_entries" android:entryValues="@array/pos_values"
                android:defaultValue="4" app:useSimpleSummaryProvider="true" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="analog_size" android:title="Kích thước (dp)"
                app:min="12" android:max="64" app:showSeekBarValue="true" android:defaultValue="28" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="analog_dx" android:title="Dịch ngang (dp)"
                app:min="-150" android:max="150" app:showSeekBarValue="true" android:defaultValue="0" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="analog_dy" android:title="Dịch dọc (dp)"
                app:min="-30" android:max="30" app:showSeekBarValue="true" android:defaultValue="0" />
            <SwitchPreferenceCompat android:key="analog_seconds" android:title="Kim giây" android:defaultValue="true" />
            <ListPreference android:key="analog_color" android:title="Màu kim mặc định (khi không có ảnh kim)"
                android:entries="@array/color_auto_entries" android:entryValues="@array/color_auto_values"
                android:defaultValue="auto" app:useSimpleSummaryProvider="true" />
            <Preference android:key="pick_dial" android:title="Chọn ảnh mặt đồng hồ" />
            <Preference android:key="clear_dial" android:title="Xoá ảnh mặt đồng hồ" />
            <Preference android:key="pick_hour" android:title="Chọn ảnh kim giờ" android:summary="Ảnh vuông cùng cỡ mặt đồng hồ, kim hướng lên 12 giờ, tâm ảnh = trục quay" />
            <Preference android:key="clear_hour" android:title="Xoá ảnh kim giờ" />
            <Preference android:key="pick_minute" android:title="Chọn ảnh kim phút" />
            <Preference android:key="clear_minute" android:title="Xoá ảnh kim phút" />
            <Preference android:key="pick_second" android:title="Chọn ảnh kim giây" />
            <Preference android:key="clear_second" android:title="Xoá ảnh kim giây" />
    </PreferenceScreen>

    <PreferenceScreen android:key="scr_icons" android:title="Ẩn / hiện biểu tượng" android:summary="Chọn biểu tượng trên thanh trạng thái cần ẩn">
            <SwitchPreferenceCompat android:key="hide_notif_icons" android:title="Ẩn biểu tượng thông báo" android:defaultValue="false" />
            <MultiSelectListPreference android:key="hidden_slots" android:title="Biểu tượng hệ thống cần ẩn"
                android:summary="Tick vào biểu tượng muốn ẩn. Danh sách tự bổ sung khi biểu tượng xuất hiện trên thanh"
                android:entries="@array/slot_entries" android:entryValues="@array/slot_values" />
    </PreferenceScreen>

    <PreferenceScreen android:key="scr_nav" android:title="Thanh điều hướng" android:summary="Chiều cao, biểu tượng Back / Home / Recents, nhấn giữ Back">
            <SwitchPreferenceCompat android:key="nav_enabled" android:title="Tuỳ chỉnh thanh điều hướng" android:summary="Dùng cho điều hướng 3 nút. Đổi chiều cao nên khởi động lại máy" android:defaultValue="false" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="nav_height_dp" android:title="Chiều cao thanh (dp)"
                app:min="24" android:max="200" app:showSeekBarValue="true" android:defaultValue="48" />
            <ListPreference android:key="nav_tint" android:title="Màu biểu tượng"
                android:entries="@array/nav_tint_entries" android:entryValues="@array/nav_tint_values"
                android:defaultValue="orig" app:useSimpleSummaryProvider="true" />
            <Preference android:key="pick_nav_back" android:title="Chọn ảnh nút Back" />
            <Preference android:key="clear_nav_back" android:title="Xoá ảnh nút Back" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="nav_back_size" android:title="Kích thước nút Back (dp)"
                app:min="12" android:max="96" app:showSeekBarValue="true" android:defaultValue="24" />
            <Preference android:key="pick_nav_home" android:title="Chọn ảnh nút Home" android:summary="Hỗ trợ file GIF động" />
            <Preference android:key="clear_nav_home" android:title="Xoá ảnh nút Home" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="nav_home_size" android:title="Kích thước nút Home / GIF (dp)"
                app:min="12" android:max="150" app:showSeekBarValue="true" android:defaultValue="24" />
            <Preference android:key="pick_nav_recent" android:title="Chọn ảnh nút Recents" />
            <Preference android:key="clear_nav_recent" android:title="Xoá ảnh nút Recents" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="nav_recent_size" android:title="Kích thước nút Recents (dp)"
                app:min="12" android:max="96" app:showSeekBarValue="true" android:defaultValue="24" />
            <Preference android:key="pick_nav_glow" android:title="Chọn ảnh glow khi nhấn nút" android:summary="Ảnh sẽ phóng từ nhỏ đến lớn, mờ phía dưới nút, thay cho hiệu ứng nhấn mặc định (nên dùng ảnh nền trong suốt)" />
            <Preference android:key="clear_nav_glow" android:title="Xoá ảnh glow (dùng lại hiệu ứng mặc định)" />
            <com.dualsb.oneui.NumberSeekBarPreference android:key="nav_glow_size" android:title="Kích thước glow lớn nhất (dp)"
                app:min="24" android:max="300" app:showSeekBarValue="true" android:defaultValue="72" />
